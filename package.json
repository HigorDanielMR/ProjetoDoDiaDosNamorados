{
  "name": "romantic-countdown-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && dotnet run",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "backend:restore": "cd backend && dotnet restore",
    "backend:build": "cd backend && dotnet build",
    "backend:watch": "cd backend && dotnet watch run"
  },
  "dependencies": {
    "vue": "^3.4.38",
    "vue-router": "^4.2.5",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vue-tsc": "^2.1.4",
    "concurrently": "^8.2.2"
  }
}